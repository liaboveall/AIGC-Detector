# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Environments
.venv/
venv/

# IDE
.vscode/

# Training artifacts
outputs/
*.pt
*.pth
*.log

# Datasets: image bodies and manifest CSVs (all >1 MB) must never be committed.
# Only the dataset documentation (README_DATASET.md, REBUILD.md) and the manifest
# rebuild script are tracked; manifests are regenerated as described in REBUILD.md.
Dataset/*
!Dataset/README_DATASET.md
!Dataset/REBUILD.md
!Dataset/audit/
Dataset/audit/*
!Dataset/audit/build_dataset_manifests.py

# Local working files
tmp/
.qoder/
AIGC检测迭代方向规划_*.md
reports/compression_history_audit/diagnostic_predictions.csv
reports/compression_history_audit/diagnostic_sample_manifest.csv

# Generated prediction output (created at repo root by README commands)
predictions.json

# Archives only live in local data staging caches.
Dataset/_archives/
Dataset/_hf_cache*/
*.tar
*.tar.gz
*.zip
*.pdf
!docs/**/*.pdf
