# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Environments
.venv/
venv/

# IDE
.vscode/

# Training artifacts
outputs/
*.pt
*.pth
*.log

# Datasets: image bodies and manifest CSVs (all >1 MB) must never be committed.
# Only Dataset/README_DATASET.md and the manifest rebuild script are tracked;
# the seed manifests are regenerated with the commands documented in the README.
Dataset/*
!Dataset/README_DATASET.md
!Dataset/audit/
Dataset/audit/*
!Dataset/audit/build_dataset_manifests.py

# Local working files
_pdf_text.txt

# Generated demo output (created at repo root by README / demo script commands)
predictions.json

# Archives only ever live in data staging caches; keep deliverable exceptions open.
Dataset/_archives/
Dataset/_hf_cache*/
*.tar
*.tar.gz
*.zip
!submission*.zip
*.pdf
!docs/**/*.pdf
